# ===========================================
# DUSt3R-PQK .gitignore
# ===========================================

# ============ 模型权重（太大，不上传）============
checkpoints/*.pth
checkpoints/*.safetensors
checkpoints/*.pt
checkpoints/*.bin
checkpoints/*.onnx
checkpoints/*.trt
checkpoints/*.engine
test_checkpoints/
*.pth
*.safetensors

# ============ 第三方代码 ============
# dust3r 作为 git submodule 管理，不在 .gitignore 中排除
# croco 是 dust3r 的 submodule，同样会被 git 管理

# HuggingFace 缓存（模型权重缓存位置）
.cache/
**/huggingface/

# ============ 数据集 ============
datasets/
data/

# ============ 输出文件 ============
outputs/
logs/*.json
logs/*.csv
reports/*.xlsx
reports/plots/

# ============ Python ============
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ============ 虚拟环境 ============
.venv/
venv/
ENV/
env/

# ============ IDE ============
.idea/
.vscode/
*.swp
*.swo
*~

# ============ 系统文件 ============
.DS_Store
Thumbs.db

# ============ Jupyter ============
.ipynb_checkpoints/
*.ipynb

# ============ 论文PDF（太大，不上传）============
docs/论文相关文献/*.pdf
论文相关文献/*.pdf
*.pdf

# ============ 临时文件 ============
*.tmp
*.temp
*.log

# ============ Markdown文件（不上传GitHub）============
*.md
docs/**/*.md
